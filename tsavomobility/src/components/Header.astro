---
import { getEntry } from 'astro:content';
import NavScroll from './NavScroll.tsx';

const settingsData = await getEntry('settings', 'main');
const { phone, email, hours, navigation } = settingsData.data;
const currentPath = Astro.url.pathname;
---

<div class="topbar">
  <div class="container topbar-inner">
    <ul class="info-list">
      <li><i class="ico">&#9742;</i> Toll Free: <strong>{phone}</strong></li>
      <li><i class="ico">&#9993;</i> Email: <strong>{email}</strong></li>
      <li><i class="ico">&#128337;</i> Mon–Fri: <strong>{hours}</strong></li>
    </ul>
    <ul class="social-list">
      <li><a href="#" aria-label="Facebook">f</a></li>
      <li><a href="#" aria-label="Twitter">t</a></li>
      <li><a href="#" aria-label="Instagram">ig</a></li>
    </ul>
  </div>
</div>

<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    <a href="/" class="logo">STUDIO<span>FORMA</span></a>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">&#9776;</button>
    <nav class="main-nav" id="mainNav">
      <ul>
        {navigation.map((item) => (
          <li>
            <a 
              href={item.url} 
              class={currentPath === item.url || (item.url !== '/' && currentPath.startsWith(item.url)) ? 'active' : ''}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<NavScroll client:load />